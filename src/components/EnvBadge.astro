---
import { SITE_ENV } from 'astro:env/client';
---

{SITE_ENV !== 'production' && <div class="env-badge">{SITE_ENV.toUpperCase()} · not the live site</div>}

<style>
	.env-badge {
		position: sticky;
		top: 0;
		z-index: 1000;
		padding: 0.25rem 1rem;
		background: #b45309;
		color: #fff;
		font: 600 0.75rem/1.5 system-ui, sans-serif;
		letter-spacing: 0.05em;
		text-align: center;
	}
</style>
