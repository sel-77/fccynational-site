---
import { Image } from 'astro:assets';
import logo from '@/assets/brand/fccy-logo.png';
import { mainNav } from '@/data/navigation';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-border">
	<div
		class="mx-auto flex max-w-6xl flex-col gap-8 px-6 py-12 text-sm text-muted-foreground md:flex-row md:items-start md:justify-between"
	>
		<div class="flex items-center gap-3">
			<Image src={logo} alt="" width={48} height={48} />
			<p class="font-heading text-base font-semibold tracking-wide text-foreground">
				Filipino-Chinese Catholic Youth
			</p>
		</div>
		<nav aria-label="Footer">
			<ul class="flex gap-6">
				{
					mainNav.map(({ label, href }) => (
						<li>
							<a href={href} class="underline-offset-4 hover:text-foreground hover:underline">
								{label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
	<p class="mx-auto max-w-6xl px-6 pb-8 text-xs text-muted-foreground">© {year} FCCY National</p>
</footer>
