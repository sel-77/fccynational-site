---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Button } from '@/components/starwind/button';
---

<BaseLayout>
	<!-- Placeholder until the Home & About tickets: previews the layout, theme, and fonts. -->
	<div class="max-w-3xl space-y-8">
		<h1>Filipino-Chinese Catholic Youth</h1>
		<h2>National Activities</h2>
		<p>
			Body text is set in Inter. Headings use Cinzel, echoing the Roman lettering on the FCCY seal.
			The site is black and white so photos and pubmats bring the color.
		</p>
		<Button href="/about">About FCCY</Button>
	</div>
</BaseLayout>
